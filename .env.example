# 心上后端 AI 配置（默认豆包 / 火山方舟 Ark，OpenAI 兼容协议；换厂商只改这几行）
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 豆包模型：填你的「推理接入点 ID」（形如 ep-xxxxxxxx）或模型名（如 doubao-pro-32k）
# AI_MODEL 为通用兜底；下面三档按场景路由，没填则回退到 AI_MODEL。
AI_MODEL=doubao-pro-32k
# 多模型路由（可选，按需开通；不填则全部走 AI_MODEL）：
# AI_MODEL_PRO=ep-xxx     # 问答/分析/生成（旗舰，如 doubao-1.5-pro-32k）
# AI_MODEL_LITE=ep-xxx    # 归类/打标/短摘要（轻量，省钱，如 doubao-1.5-lite-32k）
# AI_MODEL_LONG=ep-xxx    # 周报/月报（长上下文，如 doubao-1.5-pro-256k）
# 由你填入：火山方舟 API Key（控制台 → 方舟 → API Key）。为空时 /ai/qa 返回 needs_api_key（不使用假数据）
AI_API_KEY=

# ── 双厂商容灾（可选）：主 key 失效/限流/宕机时自动切备用，对外仍只显示 LOVEAI ──
# 最少只填 AI_API_KEY_BACKUP = 同厂商备 key；再填下面两行 = 跨厂商容灾（示例：Moonshot/Kimi）
# AI_API_KEY_BACKUP=
# AI_BASE_URL_BACKUP=https://api.moonshot.cn/v1
# AI_MODEL_BACKUP=moonshot-v1-8k
PORT=8800

# ── 生图（可选，§9）：填了才有 AI 生图；不填则前端按钮提示"未配置" ──
# AI_IMAGE_MODEL=doubao-seedream-3-0-t2i-250415   # 豆包文生图模型/接入点
# AI_IMAGE_KEY=        # 不填则复用 AI_API_KEY
# AI_IMAGE_BASE_URL=   # 不填则复用 AI_BASE_URL

# ── 免费额度：每用户终身免费 LOVEAI 次数（默认 10），会员无限 ──
# AI_FREE_LIMIT=10

# ── 订阅支付（可选）：填了密钥才真实收款；不填则下单返回 needs_config（不假成功）──
# 渠道：alipay | wechat | stripe。
#   stripe → 现已可用：只需 PAY_PROVIDER=stripe + STRIPE_SECRET_KEY（见下）即可下单。
#   alipay/wechat → 仍需同时配 PAY_MERCHANT_ID + PAY_KEY（国内渠道下单逻辑待 P2 实现）。
# PAY_PROVIDER=
# PAY_MERCHANT_ID=
# PAY_KEY=
# PAY_CERT=            # 部分渠道需要（微信 API v3 证书路径等）

# ── Stripe（首个真实渠道）──
# 控制台 → Developers → API keys 取 Secret key（sk_live_/sk_test_）。为空时下单 needs_config。
STRIPE_SECRET_KEY=
# 控制台 → Developers → Webhooks 添加端点 /sub/webhook 后取 Signing secret（whsec_...）。
# 为空时 webhook 一律 400（不假激活）。
STRIPE_WEBHOOK_SECRET=
# 付款成功/取消后跳回的前端地址（不填则用下面默认）。
PAY_SUCCESS_URL=        # 默认 https://www.loveaivip.com/?pay=ok
PAY_CANCEL_URL=         # 默认 https://www.loveaivip.com/?pay=cancel

# ── 管理员令牌（可选）：手动开通会员 POST /sub/grant 需带 X-Admin-Token 匹配此值 ──
# 用于赠送/客服补单/测试；不填则 /sub/grant 一律 403。请填一个长随机串。
# ADMIN_TOKEN=
